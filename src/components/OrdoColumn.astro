---
import PostCard from './PostCard.astro';
import { postsForDay, FORMS, usccbLink, colorName, colorVar } from '../lib/data.js';
const { form, entry, date } = Astro.props;
const { own, alt, week, same } = postsForDay(entry);
const info = FORMS[form];
---
<section class={`column ${form}`} style={`--lit:${colorVar(entry?.color)}`}>
  <header>
    <div class="eyebrow">{info.label} · {info.sub}</div>
    {entry ? (
      <>
        <h2>
          {entry.color && <span class={`swatch c-${entry.color}`} title={colorName(entry.color)} />} {entry.name}
        </h2>
        <p class="muted details">
          {form === 'no' && [entry.rank?.replace('_', ' ').toLowerCase(), colorName(entry.color), entry.season, entry.cycle].filter(Boolean).join(' · ')}
          {form === 'vo' && [entry.rank, entry.colorNote || colorName(entry.color)].filter(Boolean).join(' · ')}
        </p>
        {form === 'vo' && entry.alt?.length > 0 && (
          <p class="muted details">
            {entry.alt.map((a, i) => <>{i > 0 && '; '}{a.label === 'Commemorated' ? 'Commemoration of ' : 'In the 1962 calendar before the 2020 additions: '}{a.name}</>)}
          </p>
        )}
        {form === 'no' && entry.celebrations?.length > 1 && (
          <p class="muted details">Also: {entry.celebrations.slice(1).map((c) => c.name).join('; ')}</p>
        )}
        <p class="links">
          {form === 'vo' && entry.link && <a href={entry.link} rel="noopener">Mass texts at Divinum Officium ↗</a>}
          {form === 'no' && <a href={usccbLink(date)} rel="noopener">Readings at USCCB ↗</a>}
        </p>
      </>
    ) : (
      <h2 class="muted">Not yet published</h2>
    )}
  </header>

  {own.length > 0 && (
    <div class="group">
      <h3 class="group-title">Commentary for this day</h3>
      {own.map((p) => <PostCard post={p} />)}
    </div>
  )}
  {alt.map((a) => (
    <div class="group">
      <h3 class="group-title">{a.label === 'Commemorated' ? `Commemoration: ${a.name}` : a.name}</h3>
      {a.label !== 'Commemorated' && (
        <p class="muted note">The 1962 calendar kept this day before the 2020 additions for the USA.</p>
      )}
      {a.posts.map((p) => <PostCard post={p} />)}
    </div>
  ))}
  {week.length > 0 && (
    <div class="group">
      <h3 class="group-title">From {entry.weekName}</h3>
      <p class="muted note">On weekdays without their own proper, the Mass takes the Sunday’s prayers.</p>
      {week.map((p) => <PostCard post={p} />)}
    </div>
  )}
  {same.length > 0 && (
    <div class="group">
      <h3 class="group-title">The same prayer, discussed elsewhere</h3>
      {same.map((p) => <PostCard post={p} compact />)}
    </div>
  )}
  {entry && own.length + alt.length + week.length === 0 && (
    <p class="muted empty">No WDTPRS commentary is linked to this day yet.</p>
  )}
</section>

<style>
  .column { min-width: 0; }
  header { border-bottom: 5px solid var(--lit); margin-bottom: 16px; padding-bottom: 10px; }
  h2 { margin-top: 6px; }
  .details { margin: 0; font-size: .95rem; text-transform: none; }
  .details::first-letter { text-transform: uppercase; }
  .links { margin: 8px 0 0; font: .9rem system-ui, sans-serif; }
  .group { margin-bottom: 22px; }
  .group-title { font-size: 1.15rem; color: var(--muted); font-style: italic; font-weight: 500; }
  .note { font-size: .9rem; margin-top: -4px; }
  .empty { font-style: italic; }
</style>
