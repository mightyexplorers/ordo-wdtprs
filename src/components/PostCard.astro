---
import { url, shortDate } from '../lib/data.js';
const { post, compact = false } = Astro.props;
---
<article class="post-card">
  <div class="meta">
    <span class="tag">{post.part}</span>
    <span class="muted">{shortDate(post.date)}</span>
  </div>
  <h3><a href={url(`post/${post.id}/`)}>{post.title}</a></h3>
  {!compact && post.latin && (
    <blockquote class="latin" lang="la">{post.latin}</blockquote>
  )}
  {!compact && post.literal && (
    <div class="literal">
      <span class="eyebrow">Literal rendering</span>
      <p>{post.literal}</p>
    </div>
  )}
  {!compact && post.excerpt && <p class="excerpt">{post.excerpt}</p>}
  <a class="read" href={post.link} rel="noopener">Read the full post on wdtprs.com →</a>
  {post.reposts?.length > 0 && (
    <p class="reposts muted">
      Also posted: {post.reposts.map((r, i) => <>{i > 0 && ' · '}<a href={r.link} rel="noopener" title={r.title}>{shortDate(r.date)}</a></>)}
    </p>
  )}
</article>

<style>
  .post-card { background: var(--paper); border: 1px solid var(--rule); border-radius: 6px; padding: 16px 18px; margin-bottom: 14px; }
  .meta { display: flex; gap: 10px; align-items: center; font-size: .9rem; margin-bottom: 6px; }
  h3 { font-size: 1.25rem; margin-bottom: .5em; }
  h3 a { color: var(--ink); text-decoration: none; }
  h3 a:hover { color: var(--accent); }
  .latin { margin: 0 0 12px; padding: 4px 0 4px 14px; border-left: 3px solid var(--gold); font-style: italic; font-size: 1.08rem; }
  .literal { margin-bottom: 10px; }
  .literal p { margin: 2px 0 0; }
  .excerpt { color: var(--muted); margin: 0 0 10px; }
  .read { font: 500 .92rem system-ui, sans-serif; }
  .reposts { margin: 8px 0 0; font: .85rem system-ui, sans-serif; }
</style>
