---
import Base from '../../layouts/Base.astro';
import { allDays, dates, url, postsForDay } from '../../lib/data.js';

export function getStaticPaths() {
  const months = [...new Set(dates.map((d) => d.slice(0, 7)))];
  return months.map((month, i) => ({ params: { month }, props: { prev: months[i - 1], next: months[i + 1] } }));
}
const { month } = Astro.params;
const { prev, next } = Astro.props;
const [y, m] = month.split('-').map(Number);
const first = new Date(Date.UTC(y, m - 1, 1));
const daysInMonth = new Date(Date.UTC(y, m, 0)).getUTCDate();
const monthName = first.toLocaleString('en-US', { month: 'long', year: 'numeric', timeZone: 'UTC' });

// 'own' = commentary on the day itself, 'week' = only via the preceding Sunday.
const mark = (entry) => {
  const r = postsForDay(entry);
  return r.own.length ? 'own' : r.week.length ? 'week' : '';
};
const cells = [];
for (let i = 0; i < first.getUTCDay(); i++) cells.push(null);
for (let d = 1; d <= daysInMonth; d++) {
  const date = `${month}-${String(d).padStart(2, '0')}`;
  const day = allDays[date];
  cells.push({ d, date, day, voMark: mark(day?.vo), noMark: mark(day?.no) });
}
---
<Base title={monthName}>
  <div class="cal-head">
    <h1>{monthName}</h1>
    <nav>
      {prev && <a class="button" href={url(`calendar/${prev}/`)}>←</a>}
      {next && <a class="button" href={url(`calendar/${next}/`)}>→</a>}
    </nav>
  </div>
  <p class="legend muted">
    <span><span class="dot vo own"></span> 1962 commentary for the day</span>
    <span><span class="dot no own"></span> Novus Ordo commentary for the day</span>
    <span><span class="dot no week"></span> via the week’s Sunday</span>
  </p>
  <div class="grid" role="grid">
    {['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'].map((w) => <div class="dow">{w}</div>)}
    {cells.map((c) => c ? (
      <a class="cell" href={url(`day/${c.date}/`)} data-date={c.date}>
        <span class="num">{c.d}</span>
        {c.day?.vo && <span class="name vo"><span class={`dot vo ${c.voMark}`}></span>{c.day.vo.name}</span>}
        {c.day?.no && (
          <span class="name no">
            <span class={`dot no ${c.noMark}`}></span>{c.day.no.name}
          </span>
        )}
      </a>
    ) : <div class="cell blank"></div>)}
  </div>
</Base>

<script is:inline>
  const today = new Date();
  const iso = `${today.getFullYear()}-${String(today.getMonth() + 1).padStart(2, '0')}-${String(today.getDate()).padStart(2, '0')}`;
  document.querySelector(`[data-date="${iso}"]`)?.classList.add('today');
</script>

<style>
  .cal-head { display: flex; justify-content: space-between; align-items: center; gap: 12px; flex-wrap: wrap; }
  .cal-head nav { display: flex; gap: 8px; }
  .legend { font: .85rem system-ui, sans-serif; display: flex; flex-wrap: wrap; gap: 6px 14px; align-items: center; }
  .grid { display: grid; grid-template-columns: repeat(7, minmax(0, 1fr)); gap: 4px; }
  .dow { font: 600 .75rem system-ui, sans-serif; text-transform: uppercase; letter-spacing: .08em; color: var(--muted); padding: 4px 6px; }
  .cell {
    min-height: 118px; background: var(--paper); border: 1px solid var(--rule); border-radius: 4px; padding: 6px;
    text-decoration: none; color: var(--ink); display: flex; flex-direction: column; gap: 4px; overflow: hidden;
  }
  .cell:hover { border-color: var(--accent); }
  .cell.blank { background: transparent; border: none; }
  .cell.today { outline: 2px solid var(--accent); }
  .num { font: 600 1rem 'Cormorant Garamond', serif; }
  .name { font-size: .78rem; line-height: 1.25; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
  .name.vo { color: var(--gold); }
  .name.no { color: var(--muted); }
  .dot { display: inline-block; width: 7px; height: 7px; border-radius: 50%; margin-right: 4px; vertical-align: .1em; border: 1px solid transparent; }
  .dot.vo.own { background: var(--gold); }
  .dot.no.own { background: var(--accent); }
  .dot.week { border-color: var(--accent); }
  .dot.vo.week { border-color: var(--gold); }
  .dot:not(.own):not(.week) { display: none; }
  @media (max-width: 640px) {
    .cell { min-height: 64px; }
    .name { display: none; }
    .cell:has(.dot.own)::after { content: '•'; color: var(--accent); }
  }
</style>
