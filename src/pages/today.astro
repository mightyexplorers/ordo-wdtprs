---
import Base from '../layouts/Base.astro';
import { url } from '../lib/data.js';
---
<Base title="Today">
  <p>Opening today’s ordo… <a href={url('calendar/')}>Go to the calendar</a>.</p>
  <script is:inline define:vars={{ base: url() }}>
    const d = new Date();
    const iso = `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`;
    location.replace(`${base}day/${iso}/`);
  </script>
</Base>
